{
  "name": "night-survivors",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "assets": "node tools/build-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tools/*.test.mjs",
    "sim": "vite build --ssr tools/sim.ts --outDir .sim --minify false && node .sim/sim.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
